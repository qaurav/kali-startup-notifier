[Unit]
Description=Kali Linux Startup & Network Discord Notifier
Wants=network-online.target
After=network.target network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=/opt/kali-notifier
EnvironmentFile=-/opt/kali-notifier/.env
ExecStart=__NODE__ /opt/kali-notifier/notification_script.js "Cold Boot"
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
